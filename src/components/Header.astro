---
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
	</nav>
</header>
<style>
	.site-header {
		margin: 0;
		padding: 0 1.25rem;
		background: #fff;
		box-shadow: 0 2px 12px rgba(0, 45, 76, 0.08);
	}
	.site-header nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		min-height: 3.5rem;
	}
	.brand {
		font-weight: 700;
		font-size: 1.125rem;
		color: var(--vgc-navy);
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.brand:hover {
		color: var(--vgc-navy);
		opacity: 0.85;
	}
</style>
