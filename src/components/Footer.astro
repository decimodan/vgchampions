---
const today = new Date();
---

<footer class="site-footer">
	<p class="footer-copy">
		&copy; {today.getFullYear()} Pokémon Champions. Sample data; not affiliated with The Pokémon Company.
	</p>
</footer>
<style>
	.site-footer {
		padding: 2rem 1.25rem 3rem;
		background: #fff;
		border-top: 1px solid rgba(0, 45, 76, 0.08);
		text-align: center;
	}
	.footer-copy {
		margin: 0;
		font-size: 0.875rem;
		color: rgb(var(--gray));
		max-width: 40rem;
		margin-inline: auto;
	}
</style>
